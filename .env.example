# HAFleet ARC environment template
# Copy this file to .env and uncomment only the values you want to override.
# All values below are examples or defaults; no real credentials are included.

# -----------------------------------------------------------------------------
# OpenAI / Codex connection
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-5.6-luna

# Role-specific models. When unset, each role falls back to MODEL.
# HAFLEET_ARCHITECT_MODEL=
# HAFLEET_PLANNER_MODEL=  # legacy/custom pipelines only; default flow has no Planner role
# HAFLEET_IMPLEMENTER_MODEL=
# HAFLEET_REVIEWER_MODEL=
# HAFLEET_TESTER_MODEL=  # legacy/custom pipelines only; default flow uses Implementer
# HAFLEET_POSTFLIGHT_MODEL=

# -----------------------------------------------------------------------------
# ARC-Bench input and output paths
# -----------------------------------------------------------------------------
# ARCBENCH_TASK_DIR=requirements
# ARCBENCH_OUTPUT_DIR=.
# ARCBENCH_PROJECT_DIR=
# ARCBENCH_TEMPLATE_DIR=
# ARCBENCH_TASK_TYPE=web
# ARCBENCH_CHECKPOINT_PATH=
# ARCBENCH_PAUSE_REQUEST_PATH=
# ARCBENCH_RUNNER_EVENTS_PATH=
# ARCBENCH_TRACEABILITY_DIR=

# -----------------------------------------------------------------------------
# Ports and optional Dashboard
# -----------------------------------------------------------------------------
# ARCBENCH_WEB_PORT=3000
# ARC_WEB_PORT=3000
# HAFLEET_SMOKE_PORT=3100
# HAFLEET_DASHBOARD=0
# HAFLEET_DASHBOARD_PORT=3200

# -----------------------------------------------------------------------------
# Pipeline execution
# -----------------------------------------------------------------------------
# HAFLEET_PARALLEL=0
# HAFLEET_MAX_WORKERS=2
# HAFLEET_FINAL_REVIEW=1
# HAFLEET_TESTER=1  # enables legacy/custom Tester nodes; default flow has no Tester role
# Execute Implementer-authored, workspace-confined verification commands before review.
# HAFLEET_PROJECT_TESTS=1
# HAFLEET_TEST_TIMEOUT=600
# HAFLEET_TEST_RETRIES=1
# HAFLEET_PLAYWRIGHT_INSTALL=1
# HAFLEET_TEST_ARTIFACT_LIMIT=60000
# HAFLEET_POSTFLIGHT=1
# HAFLEET_POSTFLIGHT_REPAIRS=2
# Re-run all ROOT-scoped registered project tests after the delivery rehearsal.
# HAFLEET_FINAL_VERIFICATION=1
# HAFLEET_NPM_TIMEOUT=600
# HAFLEET_READY_TIMEOUT=45

# Agent turn timeout and retry behavior.
# HAFLEET_TURN_TIMEOUT=1200
# Number of total attempts for transient agent failures (including the first try).
# HAFLEET_MAX_ATTEMPTS=6
# Backoff delays between attempts, in seconds (the last value is reused if needed).
# HAFLEET_RETRY_DELAYS=30,60,120,180,300
# Quality-loop exhaustion policy: defer keeps unattended runs moving; pause is strict.
# HAFLEET_QUALITY_ON_EXHAUSTION=defer
# Enable the pre-implementation scenario-contract review declared in pipeline.yaml.
# HAFLEET_CONTRACT_REVIEW=1
# Independent maximum rounds for the planning contract gate.
# HAFLEET_CONTRACT_MAX_ROUNDS=2
# Absolute Reviewer pass budget. By default the YAML budget receives two extra rounds.
# HAFLEET_QUALITY_MAX_ROUNDS=5
# Independent repair budget for deterministic project verification failures.
# HAFLEET_VERIFICATION_MAX_REPAIRS=5
# Consecutive identical no-progress attempts allowed before quality is deferred.
# HAFLEET_QUALITY_STALL_LIMIT=2

# -----------------------------------------------------------------------------
# Git identity
# -----------------------------------------------------------------------------
# Role commits are generated as HAFleet-{RoleTitle} by default.
# HAFLEET_GIT_NAME_PREFIX=HAFleet-
# HAFLEET_GIT_EMAIL_DOMAIN=hafleet.local

# Generic Git identity fallback used by low-level runtime operations without a role.
# ARC_GIT_USER_NAME=ARC Bench Agent
# ARC_GIT_USER_EMAIL=arcbench@example.com
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# CODEX_HOME is managed automatically under <output>/.arc/hafleet/codex-home.
# PORT is injected automatically for agent-launched web processes.
# CODEX_HOME=
# PORT=3100
